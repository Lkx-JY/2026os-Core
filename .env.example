# ============================================================================
# Core.LinuxCommit — 环境变量配置模板
# ============================================================================
# 使用说明:
#   1. 复制此文件为 .env (cp .env.example .env)
#   2. 按需修改下方配置
#   3. 不要将 .env 提交到 Git!
# ============================================================================

# ── LLM API Key (可选) ─────────────────────────────────────────────────────
# ★ 不再强制要求！用户可在 Web 前端自行提供 API Key 或使用免费本地模型。
# 如果配置了此 Key，仅用于索引构建等系统级任务，不会在用户请求中自动消费。
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:   https://platform.openai.com/api-keys
# Qwen:     https://dashscope.console.aliyun.com/apiKey
# OPENAI_API_KEY=sk-your-api-key-here

# ── 免费本地模型 — Ollama 配置 (推荐) ──────────────────────────────────────
# 安装: curl -fsSL https://ollama.com/install.sh | sh
# 拉取: ollama pull qwen2.5:7b
# 启动: ollama serve (默认 http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ── LLM 配置 (可选) ─────────────────────────────────────────────────────────
# 默认使用 DeepSeek，可以切换到其他 OpenAI 兼容 API
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_PROVIDER=deepseek

# ── Milvus 配置 (可选) ──────────────────────────────────────────────────────
# Milvus Lite 本地数据库路径 (默认 data/milvus_lite.db)
# MILVUS_DB_PATH=data/milvus_lite.db

# Docker Milvus 模式 (如果运行了 docker compose)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# 强制使用 FAISS (跳过 Milvus)
# MILVUS_FORCE_FAISS=1

# ── 模型配置 (可选) ─────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── API 鉴权 (生产环境建议配置) ─────────────────────────────────────────
# 设置后，调用 /api/v1/analyze 等需携带 Authorization: Bearer <AUTH_API_KEY>
# 未设置则跳过鉴权（仅建议在开发环境使用）
# AUTH_API_KEY=your-secret-key-here

# ── 服务器配置 (可选) ───────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000