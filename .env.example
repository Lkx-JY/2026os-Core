# ============================================================================
# Core.LinuxCommit — 环境变量配置模板
# ============================================================================
# 使用说明:
#   1. 复制此文件为 .env (cp .env.example .env)
#   2. 填入你的真实 API Key
#   3. 不要将 .env 提交到 Git!
# ============================================================================

# ── LLM API Key (必填) ─────────────────────────────────────────────────────
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI:   https://platform.openai.com/api-keys
# Qwen:     https://dashscope.console.aliyun.com/apiKey
OPENAI_API_KEY=sk-your-api-key-here

# ── LLM 配置 (可选) ─────────────────────────────────────────────────────────
# 默认使用 DeepSeek，可以切换到其他 OpenAI 兼容 API
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_PROVIDER=deepseek

# ── Milvus 配置 (可选) ──────────────────────────────────────────────────────
# Milvus Lite 本地数据库路径 (默认 data/milvus_lite.db)
# MILVUS_DB_PATH=data/milvus_lite.db

# Docker Milvus 模式 (如果运行了 docker compose)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# 强制使用 FAISS (跳过 Milvus)
# MILVUS_FORCE_FAISS=1

# ── 模型配置 (可选) ─────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── 服务器配置 (可选) ───────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── 跳过 API Key 检查 (仅本地测试) ─────────────────────────────────────────
# SKIP_API_KEY_CHECK=1
